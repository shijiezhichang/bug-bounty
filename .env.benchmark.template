# Benchmark environment variables
# Copy to .env.benchmark and customize

# Target server URL
BENCHMARK_HOST=http://localhost:3000

# Benchmark test token (for auth-protected routes)
BENCHMARK_TOKEN=bench-test-token-12345

# Concurrency settings
BENCHMARK_CONNECTIONS=10
BENCHMARK_DURATION=10

# Thresholds (fail CI if exceeded)
BENCHMARK_P99_THRESHOLD_MS=500
BENCHMARK_ERROR_RATE_THRESHOLD=0.05
BENCHMARK_RPS_MIN=50